# ============================================================
# Aruba Voucher Backend — environment variable reference
#
# Copy this file to .env and fill in all required values
# before starting the application.
#
# Required variables are marked [REQUIRED].
# Optional variables are marked [OPTIONAL] and include
# their default values where applicable.
# ============================================================


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# [REQUIRED] PostgreSQL connection string using the asyncpg driver.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# Example: postgresql+asyncpg://voucher_user:s3cr3t@localhost:5432/voucher_db
DATABASE_URL=postgresql+asyncpg://voucher_user:changeme@localhost:5432/voucher_db


# ------------------------------------------------------------
# Admin credentials (used for initial admin account seeding)
# ------------------------------------------------------------

# [REQUIRED] Username for the default admin account created on first startup.
ADMIN_USERNAME=admin

# [REQUIRED] Password for the default admin account.
# Must be strong in production. The value is bcrypt-hashed before storage.
ADMIN_PASSWORD=changeme


# ------------------------------------------------------------
# JWT authentication
# ------------------------------------------------------------

# [REQUIRED] Secret key used to sign and verify JWT tokens.
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-key

# [OPTIONAL] JWT token lifetime in seconds. Default: 1800 (30 minutes).
JWT_EXPIRE_SECONDS=1800


# ------------------------------------------------------------
# FreeRADIUS shared secret
# ------------------------------------------------------------

# [REQUIRED] Shared secret configured on both FreeRADIUS and the Aruba AP.
# Must match the value in freeradius/clients.conf.
RADIUS_SHARED_SECRET=replace-with-radius-shared-secret


# ------------------------------------------------------------
# Application settings
# ------------------------------------------------------------

# [OPTIONAL] Runtime environment. One of: development, production. Default: production.
APP_ENV=production

# [OPTIONAL] TCP port for the Uvicorn server. Default: 8000.
APP_PORT=8000

# [OPTIONAL] Log level for the Python logging module.
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL. Default: INFO.
LOG_LEVEL=INFO


# ------------------------------------------------------------
# Rate limiting (slowapi / limits)
# ------------------------------------------------------------

# [OPTIONAL] Maximum number of requests per window for the /radius/validate endpoint.
# Default: 60.
RATE_LIMIT_REQUESTS=60

# [OPTIONAL] Duration of the rate limit sliding window in seconds. Default: 60.
RATE_LIMIT_WINDOW=60
